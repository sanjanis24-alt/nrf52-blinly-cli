# ====================================================================
# nRF / Zephyr Build Artifacts
# ====================================================================
# Ignore all build folders generated by west / ninja / cmake
build/
build_*/
_build/
bin/
obj/

# ====================================================================
# Toolchain & Workspace Dependencies (If using "West" manifest)
# ====================================================================
# If you initialized your nRF Connect SDK workspace inline, 
# ignore the entire SDK download. Only track your app!
.west/
bootloader/
modules/
tools/
zephyr/
nrfxlib/

# ====================================================================
# Compiler and Temporary Files
# ====================================================================
*.o
*.a
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.cmd
*.log

# ====================================================================
# Editor & IDE-specific settings
# ====================================================================
# VS Code (Ignore local workspace states, but DO NOT ignore launch.json or tasks.json if shared)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Segger Embedded Studio / Keil / IAR
*.emSession
*.emProject.user
*.uvguix.*
*.uvoptx
*.dep

# CLion & CMake local caches
.cmake/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake

# ====================================================================
# OS-specific files
# ====================================================================
.DS_Store
Thumbs.db
